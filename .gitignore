# Python Bytecode (Generated files)
*.pyc
__pycache__/
*~$

# Virtual Environments (Venvs)
# Essential for a clean repository—NEVER commit your venv.
.venv/
venv/
env/

# Dependency Management Files (Poetry specific)
# While pyproject.toml and poetry.lock MUST be committed, 
# sometimes temporary files or cache generated by Poetry are ignored.

# Operating System Files
.DS_Store
Thumbs.db

# IDE Files (Visual Studio Code)
.vscode/

# Environment Variables (Contains sensitive information)
# Essential for your project since you use .env
.env
